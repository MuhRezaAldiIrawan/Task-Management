    },
    "security": [
        {
            "securityScheme": "bearerAuth",
            "type": "http",
            "description": "Enter JWT token in format: Bearer {token}",
            "bearerFormat": "JWT",
            "scheme": "bearer"
        }
    ],
    "tags": [
        {
            "name": "Authentication",
            "description": "Authentication endpoints for user login, logout, and token management"
        },
        {
            "name": "Tasks",
            "description": "Task management endpoints for CRUD operations"
        },
        {
            "name": "Comments",
            "description": "Comment management endpoints for task discussions"
        },
        {
            "name": "Attachments",
            "description": "File attachment management endpoints"
        }
    ],
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
