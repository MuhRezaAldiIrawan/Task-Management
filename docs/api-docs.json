                ],
                "summary": "Delete attachment",
                "description": "Delete a file attachment and its thumbnail (if exists)",
                "operationId": "ed42d004520ba51265c0d6b30b43d9d2",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Attachment ID",
