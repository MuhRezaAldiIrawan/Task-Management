								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/tasks?page=1&per_page=10&status=pending&priority=high",
							"host": ["{{baseUrl}}"],
							"path": ["tasks"],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "per_page",
									"value": "10"
								},
								{
									"key": "status",
									"value": "pending"
								},
								{
									"key": "priority",
									"value": "high"
								}
							]
						},
						"description": "Mendapatkan daftar task dengan pagination dan filtering.\n\n**Query Parameters:**\n- `page` - Nomor halaman\n- `per_page` - Item per halaman\n- `status` - Filter status (pending, in_progress, completed, cancelled)\n- `priority` - Filter priority (low, medium, high, urgent)\n- `assigned_to` - Filter by assigned user ID\n- `created_by` - Filter by creator user ID\n- `search` - Search in title/description\n- `sort_by` - Sort field (created_at, updated_at, priority, status)\n- `sort_order` - asc atau desc"
					},
					"response": []
				},
